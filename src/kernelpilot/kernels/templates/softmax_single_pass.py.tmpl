import torch
import triton
import triton.language as tl

BLOCK_N = $BLOCK_N
NUM_WARPS = $num_warps
NUM_STAGES = $num_stages

_compiled = []


@triton.jit
def softmax_kernel(out_ptr, in_ptr, in_stride, out_stride, n_cols, BLOCK_N: tl.constexpr):
    # one program per row, whole row lives in registers
    row = tl.program_id(0)
    cols = tl.arange(0, BLOCK_N)
    mask = cols < n_cols
    x = tl.load(in_ptr + row * in_stride + cols, mask=mask, other=float("-inf"))
    x = x.to(tl.float32)
    x = x - tl.max(x, axis=0)
    num = tl.exp(x)
    den = tl.sum(num, axis=0)
    y = num / den
    tl.store(out_ptr + row * out_stride + cols, y.to(out_ptr.dtype.element_ty), mask=mask)


def launch(x):
    n_rows, n_cols = x.shape
    assert n_cols <= BLOCK_N, "single-pass softmax needs BLOCK_N >= n_cols"
    out = torch.empty_like(x)
    handle = softmax_kernel[(n_rows,)](
        out, x, x.stride(0), out.stride(0), n_cols,
        BLOCK_N=BLOCK_N, num_warps=NUM_WARPS, num_stages=NUM_STAGES,
    )
    _compiled[:] = [handle]
    return out
